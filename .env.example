# Copy this file to .env and fill in real values. Never commit .env.
# Running in Docker? Zetaris and Nightshift run on your machine, outside the container:
# use host.docker.internal instead of localhost in the URLs below.

# --- Pipeline ---
# true = run the whole pipeline on data/sample/ with no Zetaris, Nightshift or network access
SAMPLE_MODE=false
# Port for run.py (POST /run)
PORT=8000
# Stop the run between stages after this many seconds and return a partial result
RUN_TIMEOUT_S=600
# CPU embedding profile: semcse (scientific semantic similarity) or minilm (faster baseline).
EMBEDDING_PROFILE=semcse
# Optional local model directory; default data/cache/embedding-model-semcse (minilm: embedding-model).
# Prepare once with python scripts/setup_embeddings.py. No runtime model downloads.
# EMBEDDING_MODEL_DIR=/absolute/path/to/embedding-model

# --- LLM: Meterless Nightshift (primary AI provider, OpenAI-compatible) ---
# The model (an NVIDIA Nemotron model) is set in litagent/config.py (NIGHTSHIFT_MODEL).
# The NVIDIA API key lives in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://localhost:TODO-port/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# --- Zetaris (data layer, runs locally in Docker) ---
# Names from https://github.com/zetaris/getting-started/blob/main/.env.example
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create the key in the Zetaris GUI
ZETARIS_API_KEY=your-zetaris-api-key
# Our paper store (docker-compose.yml). The app writes here; Zetaris reads it as the litagent_db data source.
# PAPERS_DB_URL is how this app connects (from Docker: host.docker.internal instead of localhost);
# PAPERS_DB_JDBC_URL is how Zetaris's containers connect. Run scripts/setup_zetaris.py once.
PAPERS_DB_PASSWORD=litagent-local
PAPERS_DB_URL=postgresql://litagent:litagent-local@localhost:5433/litagent
PAPERS_DB_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/litagent

# --- Scholarly APIs ---
# OpenAlex: free key from openalex.org raises the daily limit 10x (about 100 -> 1,000 searches a day)
OPENALEX_API_KEY=
# Used only when there is no API key
OPENALEX_EMAIL=you@example.com
# Optional: Semantic Scholar key. Without it Semantic Scholar is not searched (its shared keyless limit returns 429)
SEMANTIC_SCHOLAR_API_KEY=
# Optional: which scholarly APIs to search, comma-separated (default openalex,arxiv, plus semantic_scholar with a key)
# RETRIEVAL_SOURCES=openalex,semantic_scholar,arxiv
